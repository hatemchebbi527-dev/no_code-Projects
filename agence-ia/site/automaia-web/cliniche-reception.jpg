.header {
  position: sticky;
  top: 0;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  z-index: 100;
  border-bottom: 1px solid var(--border);
}

.inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 76px;
}

.logo { display: flex; align-items: center; }

.nav {
  display: flex;
  align-items: center;
  gap: 28px;
}

.link {
  font-weight: 600;
  font-size: 0.92rem;
  color: var(--ink);
  padding: 10px 14px;
  border-radius: 8px;
  transition: color .15s ease, background .15s ease;
}
.link:hover { color: var(--teal-dark); background: rgba(22,184,166,0.08); }

.burger {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
}
.burger span {
  width: 26px;
  height: 3px;
  background: var(--navy);
  border-radius: 2px;
}

@media (max-width: 820px) {
  .burger { display: flex; }
  .nav {
    position: absolute;
    top: 76px;
    left: 0;
    right: 0;
    background: var(--white);
    border-bottom: 1px solid var(--border);
    flex-direction: column;
    gap: 18px;
    padding: 24px;
    transform: translateY(-150%);
    transition: transform .25s ease;
  }
  .navOpen { transform: translateY(0); }
  .nav .btn { width: 100%; text-align: center; }
}
