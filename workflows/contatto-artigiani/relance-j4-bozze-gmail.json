      "name": "Chiudi senza relance",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst relanci = sd.relanci || 0;\nconst risposte = sd.risposte || [];\nconst mai = sd.mai_inviati || [];\n\nconst messaggio = relanci + ' bozze di relance pronte in Gmail.'\n  + (risposte.length ? ' ' + risposte.length + ' hanno gia risposto, da guardare a mano.' : '')\n  + (mai.length ? ' ' + mai.length + ' non verificati.' : '');\n\nconsole.log(messaggio);\nif (risposte.length) console.log('Hanno risposto:\\n' + risposte.join('\\n'));\nif (mai.length) console.log('Non verificati:\\n' + mai.join('\\n'));\n\nreturn [{ json: { relanci, risposte, mai_verificati: mai, messaggio } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
