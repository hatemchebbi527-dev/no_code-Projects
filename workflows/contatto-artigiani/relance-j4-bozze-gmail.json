    {
      "parameters": {
        "method": "POST",
        "url": "https://api.notion.com/v1/databases/e29b4127-a440-4683-9f62-7d1aef3dfeaf/query",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "notionApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ page_size: 100, filter: { and: [ { property: \"Contattato\", checkbox: { equals: true } }, { property: \"Follow-up J+4\", checkbox: { equals: false } }, { property: \"Stato\", select: { equals: \"Contattato\" } }, { property: \"Ultimo contatto\", date: { on_or_before: $now.minus(4, 'days').toISODate() } } ] } }) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        0
      ],
      "id": "notion-contattati-da-4-giorni",
      "name": "Notion - Contattati da 4 giorni"
    },
    {
      "parameters": {
        "jsCode": "function testo(prop) {\n  if (!prop) return '';\n  if (prop.type === 'title')     return (prop.title || []).map(t => t.plain_text).join('');\n  if (prop.type === 'rich_text') return (prop.rich_text || []).map(t => t.plain_text).join('');\n  if (prop.type === 'select')    return prop.select ? prop.select.name : '';\n  if (prop.type === 'email')     return prop.email || '';\n  return '';\n}\n\nconst pagine = ($input.first().json || {}).results || [];\nconst out = pagine.map(pg => {\n  const pr = pg.properties || {};\n  return { json: {\n    pageId:  pg.id,\n    nome:    testo(pr['Nome']),\n    email:   testo(pr['Email']),\n    citta:   testo(pr['Citta']),\n  }};\n}).filter(i => i.json.email);\n\nconst sd = $getWorkflowStaticData('global');\nsd.relanci = 0;\nsd.risposte = [];\nsd.mai_inviati = [];\n\nconsole.log('Da relanciare, prima delle verifiche Gmail: ' + out.length);\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "id": "estrai-da-relanciare",
      "name": "Estrai da relanciare"
    },
