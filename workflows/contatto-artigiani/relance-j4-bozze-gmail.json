      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1120,
        160
      ],
      "id": "gmail-cerca-risposta",
      "name": "Gmail - Cerca risposta",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Due verifiche prima di relanciare, nell'ordine che conta.\nconst p = $('Uno alla volta').first().json;\nconst sd = $getWorkflowStaticData('global');\n\nconst messaggi = $input.all().map(i => i.json).filter(m => m && m.id);\n\n// La ricerca Gmail e andata in errore: non si relancia al buio.\nconst inviati = $('Gmail - Cerca inviata').first().json;\nif (inviati && inviati.error) {\n  sd.mai_inviati.push(p.nome + ' (verifica Gmail fallita)');\n  return [{ json: { ...p, relanciare: false, motivo: 'verifica fallita' } }];\n}\n\n// Nessuna risposta trovata: si puo relanciare.\nif (messaggi.length === 0) {\n  return [{ json: { ...p, relanciare: true, motivo: 'nessuna risposta' } }];\n}\n\n// Ha risposto: niente relance, e lo si segnala nel riepilogo.\nsd.risposte.push(p.nome + ' <' + p.email + '>');\nreturn [{ json: { ...p, relanciare: false, motivo: 'ha risposto' } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1344,
        160
      ],
      "id": "controllo-risposte",
      "name": "Controllo risposte"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "if-rel-1",
              "leftValue": "={{ $json.relanciare }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        1568,
        160
      ],
      "id": "da-relanciare-",
      "name": "Da relanciare?"
    },
    {
      "parameters": {
        "jsCode": "const FIRMA_NOME = 'Hatem Chebbi';\nconst SIGNUP     = 'https://manuvo.automa-ia.net/signup';\n\nconst p = $input.first().json;\n\n// Relance corta: richiama il primo messaggio, non lo ripete.\nconst corpo = [\n  'Buongiorno,',\n  '',\n  'Le avevo scritto qualche giorno fa a proposito di Manuvo, il servizio che mette in '\n    + 'contatto i privati di Rimini e dintorni con gli artigiani della zona.',\n  '',\n  'Capisco che in questo periodo il tempo manchi. Le lascio il link, senza impegno: '\n    + SIGNUP,\n  '',\n  'Se non le interessa, me lo dica pure in una riga e non la disturbo più.',\n  '',\n  'Un saluto,',\n  FIRMA_NOME,\n].join('\\n');\n\nreturn [{ json: { ...p, oggetto: 'Re: ' + (p.oggetto || 'Richieste di lavoro'), corpo } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        64
