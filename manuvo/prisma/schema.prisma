// Manuvo - schema de base de donnees (PostgreSQL).
// Les champs "enumeres" (role, categorie, urgence, statut) sont des String
// valides cote code par les types/constantes de src/lib/constants.ts,
// pour rester simples a faire evoluer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Comptes: artisans (ARTIGIANO) et administrateur (ADMIN).
// Les particuliers (privati) ne creent pas de compte : ils publient une demande (Lead).
model User {
  id           String   @id @default(cuid())
  matricule    Int      @unique @default(autoincrement()) // identifiant sequentiel affiche ART-0001
  email        String   @unique
  passwordHash String
  role         String   @default("ARTIGIANO") // ARTIGIANO | ADMIN
  name         String
  piva         String?  @unique // Partita IVA (11 cifre) : cle anti-abus des credits de bienvenue, une fois par P.IVA
  phone        String?
  city         String?
  country      String   @default("IT")
  categories   String   @default("") // codes categories separes par des virgules
  credits      Int      @default(0)  // solde de credits (1 credit = 2 EUR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unlocks      Unlock[]
  transactions CreditTransaction[]
  resetTokens  PasswordResetToken[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  reviews      Review[]
  messages     Message[]

  @@index([role])
}

// Messaggeria in-app admin <-> artigiano (un thread per artigiano).
model Message {
  id        String    @id @default(cuid())
  userId    String
  fromAdmin Boolean   @default(false) // true = messaggio dell'admin, false = dell'artigiano
  body      String
  readAt    DateTime? // quando il destinatario l'ha letto
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Notification in-app (una nuova richiesta corrisponde ai mestieri/zona dell'artigiano).
model Notification {
  id        String    @id @default(cuid())
  userId    String
  leadId    String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId])
  @@index([userId])
}

// Abbonamento Web Push di un dispositivo dell'artigiano.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Jeton de reinitialisation de mot de passe (on stocke le hash du jeton, pas le jeton brut).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Demande publiee par un particulier.
model Lead {
  id           String   @id @default(cuid())
  category     String   // code categorie (voir CATEGORIES)
  country      String   @default("IT")
  city         String
  description  String
  urgency      String   @default("ASAP") // ASAP | THIS_WEEK | NOT_URGENT

  // Coordonnees du particulier (masquees tant qu'un artisan ne debloque pas)
  contactName  String
  contactPhone String
  contactEmail String?

  creditCost   Int      @default(4) // cout du contact en credits, fixe par l'admin (3..5)
  status       String   @default("OPEN") // OPEN | CLOSED
  unlocksCount Int      @default(0) // nb d'artisans ayant debloque
  maxUnlocks   Int      @default(3) // plafond : 3 artisans max par demande

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  unlocks      Unlock[]
  notifications Notification[]
  reviews      Review[]

  @@index([status])
  @@index([category])
  @@index([country])
}

// Avis client (etoiles) demande par l'artisan qui a traite la demande.
// Le lien est envoye par SMS au client : l'artisan ne le voit pas (anti auto-notation).
// Base du futur badge "artisan verifie".
model Review {
  id          String    @id @default(cuid())
  artisanId   String
  leadId      String
  token       String    @unique // lien public d'avis, non devinable
  rating      Int?      // 1..5, null tant que le client n'a pas soumis
  comment     String?
  createdAt   DateTime  @default(now())
  submittedAt DateTime?

  artisan     User @relation(fields: [artisanId], references: [id], onDelete: Cascade)
  lead        Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([artisanId, leadId]) // une demande d'avis par artisan et par demande
  @@index([artisanId])
}

// Ebauche de demande : identite (et coordonnees) captees pendant que le
// particulier remplit /pubblica, enregistrees avant la soumission finale.
// Permet de ne pas perdre le contact si la demande n'est pas finalisee.
// convertedAt est renseigne quand l'ebauche aboutit a une vraie demande (Lead).
model LeadDraft {
  id           String    @id @default(cuid())
  firstName    String
  lastName     String
  phone        String?
  email        String?
  category     String?
  city         String?
  country      String?
  convertedAt  DateTime? // date de conversion en Lead (null = ebauche non finalisee)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([convertedAt])
}

// Verification du telephone du particulier par code SMS (anti-faux-leads).
// Le code (6 chiffres) est stocke hashe ; une demande n'est publiable que si
// un enregistrement verifie et recent existe pour ce numero.
model PhoneVerification {
  id         String    @id @default(cuid())
  phone      String    // numero E.164
  codeHash   String    // sha256 de "phone:code"
  attempts   Int       @default(0)
  verifiedAt DateTime? // date de verification reussie (null = pas encore verifie)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())

  @@index([phone])
}

// Deblocage : un artisan a paye pour voir le contact d'une demande.
model Unlock {
  id           String   @id @default(cuid())
  userId       String
  leadId       String
  creditsSpent Int
  createdAt    DateTime @default(now())

  // Remboursement anti-faux-leads : l'artisan signale un contact faux/injoignable,
  // l'admin valide et rembourse les credits depenses.
  refundStatus      String    @default("NONE") // NONE | REQUESTED | APPROVED | REJECTED
  refundReasonCode  String?   // FAKE_NUMBER | NO_ANSWER | OTHER
  refundReason      String?   // note libre facoltativa
  refundRequestedAt DateTime?
  refundedAt        DateTime?

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([userId, leadId]) // un artisan ne paie qu'une fois le meme lead
  @@index([leadId])
  @@index([userId])
  @@index([refundStatus])
}

// Journal des mouvements de credits (achats et depenses).
model CreditTransaction {
  id        String   @id @default(cuid())
  userId    String
  type      String   // PURCHASE | SPEND
  credits   Int      // positif pour un achat, negatif pour une depense
  amountEur Float    @default(0)
  reference String?  // leadId pour une depense, packId pour un achat
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Packs de recharge proposes aux artisans.
model CreditPack {
  id        String   @id @default(cuid())
  credits   Int
  priceEur  Float
  popular   Boolean  @default(false)
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
}
