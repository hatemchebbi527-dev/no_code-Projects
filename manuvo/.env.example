# Manuvo - modele de variables d'environnement (a copier en .env)

# Base de donnees PostgreSQL (obligatoire).
# Prod: URL fournie par Vercel Postgres / Neon / Supabase.
# Dev local: ta propre URL Postgres (ou celle de Neon).
DATABASE_URL="postgresql://user:password@host:5432/manuvo?schema=public"

# Secret de session Auth.js (obligatoire). Generer: openssl rand -base64 32
AUTH_SECRET=""

# Compte admin cree au premier deploiement (facoltativo, valeurs par defaut sinon)
ADMIN_EMAIL="admin@manuvo.app"
ADMIN_PASSWORD="change-me"
