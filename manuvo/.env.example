# Manuvo - modele de variables d'environnement (a copier en .env)
# Dev: SQLite. Prod: remplacer par une URL Postgres (Supabase/Neon) et
# changer le provider dans prisma/schema.prisma en "postgresql".
DATABASE_URL="file:./dev.db"

# Secret de session Auth.js (obligatoire). Generer: openssl rand -base64 32
AUTH_SECRET=""
